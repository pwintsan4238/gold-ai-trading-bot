# Copy this file to ".env" and edit. Everything is optional — defaults are safe.

# paper (simulator, no MT5) | mt5 (MetaTrader 5 terminal, Windows)
TRADING_MODE=paper

SYMBOL=XAUUSD
TIMEFRAME=M15

# Account / risk
PAPER_START_BALANCE=10000
RISK_PER_TRADE=0.01          # 1% of balance per trade
MAX_TRADES_PER_DAY=5
MAX_DAILY_LOSS=0.03          # 3% of balance -> auto-stop for the day
MIN_RISK_REWARD=1.5
MIN_CONFIDENCE=60
MAX_OPEN_TRADES=1

# Auto-trading starts OFF for safety. Flip it from the dashboard.
AUTO_TRADE_DEFAULT=false
LOOP_INTERVAL_SEC=15

# AI — leave blank to use the built-in rule engine (no key needed)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Strategy used on first run: ai | rules | tradingview | custom:<file_name>
DEFAULT_STRATEGY=ai

# TradingView webhooks (leave passphrase blank to auto-generate one)
TV_PASSPHRASE=
TV_SIGNAL_MAX_AGE_SEC=300
TV_DEFAULT_CONFIDENCE=80
TV_CLOSE_ON_OPPOSITE=true
TV_CHART_SYMBOL=OANDA:XAUUSD

# MetaTrader EAs — auto-detected on Windows; only set these if detection fails
MT5_TERMINAL_PATH=
MT5_METAEDITOR_PATH=
MT5_DATA_PATH=
MT4_TERMINAL_PATH=
MT4_METAEDITOR_PATH=
MT4_DATA_PATH=
ALLOW_LIVE_ACCOUNT=false
EA_GUARDIAN=true

# Server
HOST=127.0.0.1
PORT=8000
